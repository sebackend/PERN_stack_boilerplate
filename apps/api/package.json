{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "pnpm --filter @repo/shared build && tsc -b tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/server.js",
    "lint": "eslint src",
    "test": "pnpm --filter @repo/shared build && vitest run",
    "test:coverage": "pnpm --filter @repo/shared build && vitest run --coverage",
    "test:watch": "pnpm --filter @repo/shared build && vitest",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@repo/shared": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.9",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "@repo/tsconfig": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "dotenv-cli": "^11.0.0",
    "@types/node": "^26.6.3",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "@types/supertest": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
